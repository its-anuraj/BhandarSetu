# ==============================================================================
# AnajBahi (अनाज बही) Environment Configuration
# ==============================================================================
# In production / cloud mode, connect to your Supabase PostgreSQL backend.
# If these variables are omitted, AnajBahi operates in authenticated Local Demo Mode
# with seed data, persistent IndexedDB storage, and full FIFO execution.

# Public Supabase Project URL (Client-safe)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Public Supabase Anon Key (Client-safe, protected by PostgreSQL Row Level Security)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Default Organization and Godown Context
VITE_DEFAULT_ORG_NAME="Haryana State Civil Supplies Corporation"
VITE_DEFAULT_GODOWN_CODE="WH-DEL-04"
VITE_DEFAULT_GODOWN_NAME="Central Grain Store — Demo"
